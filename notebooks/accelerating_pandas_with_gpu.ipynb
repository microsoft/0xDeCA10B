    "\n",
    "# Define the number of rows\n",
    "num_rows = 1000000\n",
    "\n",
    "# Define the possible values\n",
    "states = ["NY", "NJ", "CA", "TX"]\n",
    "violations = ["Double Parking", "Expired Meter", "No Parking", "Fire Hydrant", "Bus Stop"]\n",
    "vehicle_types = ["SUBN", "SDN"]\n",
    "\n",
    "start_date = "2022-01-01"\n",
